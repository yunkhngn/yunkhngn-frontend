# Database Connection
# Note: For local Docker setup with azure-sql-edge, use port 1434 and encrypt=false
DATABASE_URL="sqlserver://localhost:1434;database=blogdb;user=sa;password=YourStrong@Passw0rd;encrypt=false"

# Server Port
PORT=3001

# Firebase Admin SDK
# Path to your service account JSON file (relative to project root or absolute)
FIREBASE_CREDENTIALS="./firebase-admin-sdk.json"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
