generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  thumbnail   String?
  tags        String?   // Stored as JSON string or comma-separated
  contentJSON String    @db.NVarChar(Max) // TipTap JSON content
  status      String    @default("DRAFT") // DRAFT, PUBLISHED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.NVarChar(Max)
  techStack   String?  // Stored as JSON string
  tags        String?
  repoLink    String?
  demoLink    String?
  cover       String?
  contentJSON String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
}

model Comment {
  id          String   @id @default(uuid())
  content     String   @db.NVarChar(Max)
  uid         String   // Firebase UID
  displayName String?
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  blogId      String
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model Gallery {
  id        String   @id @default(uuid())
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

model Settings {
  id           Int     @id @default(1)
  siteTitle    String?
  bio          String? @db.NVarChar(Max)
  avatarUrl    String?
  socialLinks  String? // Stored as JSON string
  designTokens String? // Stored as JSON string
}

model User {
  id        String   @id @default(uuid())
  uid       String   @unique // Firebase UID
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  avatarUrl String?
  createdAt DateTime @default(now())
}
