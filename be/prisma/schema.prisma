generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  thumbnail   String?
  tags        String? // Stored as JSON string or comma-separated
  contentJSON String    @db.NVarChar(Max) // TipTap JSON content
  status      String    @default("DRAFT") // DRAFT, PUBLISHED
  
  // SEO Fields
  seoTitle       String?   @db.NVarChar(60)
  seoDescription String?   @db.NVarChar(160)
  seoImage       String?
  imageSettings  String?   @db.NVarChar(Max) // JSON: { desktop: {x,y}, mobile: {x,y}, seo: {x,y} }

  views       Int?      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@map("blogs")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.NVarChar(Max)
  techStack   String? // Stored as JSON string
  tags        String?
  repoLink    String?
  demoLink    String?
  cover       String?
  contentJSON String?  @db.NVarChar(Max)

  // SEO Fields
  seoTitle       String?   @db.NVarChar(60)
  seoDescription String?   @db.NVarChar(160)
  seoImage       String?

  createdAt   DateTime @default(now())
  comments    Comment[]

  @@map("projects")
}

model Comment {
  id            String   @id @default(uuid())
  content       String   @db.NVarChar(Max)
  uid           String // Firebase UID
  displayName   String?
  hidden        Boolean  @default(false)
  deleted       Boolean  @default(false)
  upvoteCount   Int      @default(0)
  downvoteCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  blogId String?
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  votes   CommentVote[]
  reports CommentReport[]

  @@index([blogId])
  @@index([projectId])
  @@index([uid])
  @@map("comments")
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String
  uid       String // Firebase UID
  value     Int // 1 = upvote, -1 = downvote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, uid])
  @@index([commentId])
  @@index([uid])
  @@map("comment_votes")
}

model CommentReport {
  id          String   @id @default(uuid())
  commentId   String
  reporterUid String // Firebase UID
  reason      String   @db.NVarChar(Max)
  status      String   @default("pending") // pending, resolved, dismissed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterUid])
  @@index([commentId])
  @@index([reporterUid])
  @@index([status])
  @@map("comment_reports")
}

model Album {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  coverPhotoId String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  photos       Gallery[]

  @@map("albums")
}

model Gallery {
  id        String   @id @default(uuid())
  imageUrl  String
  caption   String?
  albumId   String?
  album     Album?   @relation(fields: [albumId], references: [id])
  tags      String?  // Comma-separated tags
  views     Int      @default(0)
  sortOrder Int      @default(0)
  exifData  String?  @db.NVarChar(Max) // JSON: camera, lens, focalLength, aperture, shutter, iso
  blurHash  String?  // Cloudinary blur placeholder URL
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  reactions PhotoReaction[]

  @@index([albumId])
  @@map("gallery")
}

model PhotoReaction {
  id           String   @id @default(uuid())
  photoId      String
  uid          String // Firebase UID
  reactionType String // 'like', 'heart', 'cat', 'fire', 'laugh'
  createdAt    DateTime @default(now())

  photo Gallery @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, uid])
  @@index([photoId])
  @@index([uid])
  @@map("photo_reactions")
}

model Contact {
  id            String    @id @default(uuid())
  name          String
  email         String
  phone         String?
  company       String?
  subject       String
  message       String    @db.NVarChar(Max)
  category      String    @default("general") // general, business, support, feedback
  status        String    @default("new") // new, read, responded
  adminResponse String?   @db.NVarChar(Max)
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("contacts")
}

model Settings {
  id           Int     @id @default(autoincrement())
  settingTitle String  @unique
  content      String? @db.NVarChar(Max)

  @@map("settings")
}

model User {
  id        String   @id @default(uuid())
  uid       String   @unique // Firebase UID
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  avatarUrl String?
  createdAt DateTime @default(now())

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // CONTACT, COMMENT, LIKE
  message   String   @db.NVarChar(Max)
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String?  @unique // For unsubscribe
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model ShortLink {
  id        String    @id @default(uuid())
  code      String    @unique
  targetUrl String    @db.NVarChar(2048)
  title     String?
  clicks    Int       @default(0)
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("short_links")
}

model Journal {
  id        String   @id @default(uuid())
  content   String   @db.NVarChar(Max)
  mood      String   @default("coding") // happy, coffee, coding, productive, love, fire, tired, chill, rainy, music, inspired, reading
  tags      String?  @db.NVarChar(Max) // Stored as JSON array string
  images    String?  @db.NVarChar(Max) // Stored as JSON array string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId  String?
  parent    Journal?  @relation("JournalReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Journal[] @relation("JournalReplies")
  reactions JournalReaction[]

  @@index([createdAt])
  @@index([mood])
  @@index([parentId])
  @@map("journals")
}

model Letter {
  id        String       @id @default(uuid())
  code      String       @unique
  title     String?
  password  String? // bcrypt hash, null = public
  status          String       @default("processing") // processing, ready, failed
  isActive        Boolean      @default(true)
  enableAnimation Boolean      @default(true) // Whether to display handwriting animation
  views           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  pages     LetterPage[]

  @@index([code])
  @@index([isActive])
  @@index([status])
  @@map("letters")
}

model LetterPage {
  id           String   @id @default(uuid())
  letterId     String
  imageUrl     String   @db.NVarChar(2048)
  revealMapUrl String?  @db.NVarChar(2048) // grayscale timing map from OpenCV
  width        Int?
  height       Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([letterId])
  @@map("letter_pages")
}

model JournalReaction {
  id        String   @id @default(uuid())
  journalId String
  uid       String
  type      String   // like, heart, etc.
  createdAt DateTime @default(now())

  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([journalId, uid])
  @@index([journalId])
  @@index([uid])
  @@map("journal_reactions")
}
