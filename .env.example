# API Configuration
NEXT_PUBLIC_API_URL=https://api.yunkhngn.dev
# Server-side fetches only (App Router RSC, sitemap, etc.). Prefer this over exposing API URL to the client where possible.
API_URL=https://api.yunkhngn.dev

# Optional: canonical origin for sitemap/SEO (see app/sitemap.js)
# NEXT_PUBLIC_BASE_URL=https://yunkhngn.dev

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key

# Other Services
# Google Analytics (public measurement ID only)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# AI / Gemini: NEVER use NEXT_PUBLIC_* for API keys. Configure on the backend:
#   - yunkhngn-be: GEMINI_API_KEY in .env, and/or
#   - Admin → Site Settings → gemini_api_key (stored server-side).
# The frontend only calls /ai/* and /chat on your API; it never embeds Gemini keys.
